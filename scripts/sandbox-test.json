{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [],
    "allowAllUnixSockets": true
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.netrc",
      "~/.git-credentials",
      "~/.aws",
      "~/.azure",
      "~/.kube",
      "~/.docker",
      "~/.config/gcloud",
      "~/.config/gh",
      "~/.config/epistole",
      "~/.config/schole",
      "~/.claude",
      "~/.claude.json",
      "~/.codex",
      "~/.copilot",
      "/var/run/docker.sock",
      "/run/docker.sock",
      "/tmp",
      "/run/user",
      "/run/WSL",
      "/run/dbus",
      "/mnt",
      "~/.claude-science"
    ],
    "allowWrite": [
      ".",
      "@SANDBOX_TMP@"
    ],
    "denyWrite": [
      "./.venv",
      "./.claude/settings.json",
      "./.claude/settings.local.json",
      "./.claude/hooks",
      "./.claude/skills"
    ],
    "allowRead": [
      ".",
      "@SANDBOX_TMP@"
    ]
  }
}
