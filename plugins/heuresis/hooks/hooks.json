{
  "description": "Hands the search keys saved with /plugin configure to Claude Code's Bash commands through a private per-session file in the plugin data folder, deleted when the session ends. A key already in the Bash environment wins.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_keys.py\" start; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_keys.py\" end; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
