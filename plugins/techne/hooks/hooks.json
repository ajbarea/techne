{
  "description": "Opt-in guards on git commit, git add and gh pr. Each is off until switched on in /config; with all off, the shell stops before python3 starts.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_PLUGIN_OPTION_BLOCK_ATTRIBUTION_TRAILERS$CLAUDE_PLUGIN_OPTION_BLOCK_COMMITS_MD$CLAUDE_PLUGIN_OPTION_WARN_MAIN_CHECKOUT_COMMIT\" in *true*) exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guards.py\" ;; esac",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
