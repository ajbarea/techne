{
  "description": "Opt-in guards on git commit, git add and gh pr. Each is off until switched on in /config.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/git_guards.py", "git"],
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/git_guards.py", "gh"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
