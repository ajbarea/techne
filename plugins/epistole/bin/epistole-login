#!/usr/bin/env bash
# One-time browser sign-in for an epistole account. Run it in Claude Code as: !epistole-login <alias>
set -euo pipefail
command -v uv >/dev/null 2>&1 || {
  printf 'epistole needs uv, which is not on PATH.\n  fix: curl -LsSf https://astral.sh/uv/install.sh | sh\nOpen a new terminal, then run this command again.\n' >&2
  exit 127
}
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export UV_PROJECT_ENVIRONMENT="${XDG_CACHE_HOME:-$HOME/.cache}/epistole/venv"
# uv runs from the plugin root, so a relative --client path must resolve against this directory.
export EPISTOLE_CWD="$PWD"
# The full path, for retry hints printed to a terminal, where epistole-login is not on PATH.
export EPISTOLE_LOGIN="$root/bin/epistole-login"
exec uv run --quiet --directory "$root" python -m epistole.login "$@"
