{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": []
    },
    "filesystem": {
      "denyRead": [
        "~/ajsoftworks",
        "~/.claude",
        "~/.claude-personal",
        "~/.config/gh",
        "~/.ssh",
        "~/.git-credentials",
        "~/.cache/techne-quality/done",
        "~/.cache/techne-quality/score",
        "~/.cache/techne-quality/check",
        "~/.cache/techne-quality/judge"
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  }
}
